# The isolated browser for the web page reader (docs/decisions/0029). One image for two containers: the
# Camoufox browser server (`python -m agent_helper.browser_server`) and the browse gateway
# (`python -m agent_helper.browse_gateway`), so the Playwright client and server always match.
#
# Everything that goes into the image is pinned:
# - the base image by digest (the same as the service's Dockerfile);
# - the distribution packages the browser needs, by installing them from a fixed Debian snapshot;
# - the Python packages by hash (requirements-browser.lock);
# - the browser build by the SHA-256 of its release asset, checked on the downloaded archive.
# Update them together and deliberately (docs/operations.md, "Web page reader").
ARG BASE_REGISTRY=docker.io/library
FROM ${BASE_REGISTRY}/python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f

# Debian packages as they were at this moment (snapshot.debian.org).
ARG DEBIAN_SNAPSHOT=20261001T000000Z
# The release asset of the browser build that camoufox 0.5.8 pairs with (v156.0.1-beta.36).
ARG CAMOUFOX_SHA256_AMD64=72637885ee67c93466ad377831c647192f8f08fb5c6fd9279de1320b49dd2b53
ARG CAMOUFOX_SHA256_ARM64=8b5fd083721c807ee2a752265683482477105052fa0e21739388b527ae067c15
ARG TARGETARCH

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/home/app

WORKDIR /app
COPY requirements-browser.lock ./
RUN sed -i \
        -e "s|http://deb.debian.org/debian-security|http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}|" \
        -e "s|http://deb.debian.org/debian|http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}|" \
        /etc/apt/sources.list.d/debian.sources \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot \
    && pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements-browser.lock \
    && python -m playwright install-deps firefox \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10002 --create-home --home-dir /home/app app
COPY agent_helper ./agent_helper
# camoufox keeps fpgen's fingerprint model in site-packages, which belongs to root. Install the pinned model
# (camoufox checks the archive and every file against its own pinned sha256) while still root; the app user
# only reads it later (issue #45).
RUN python -m agent_helper.browser_server --install-model

USER app
# Fetch the paired browser build. The downloaded archive itself is hashed and compared with the pinned
# digest before it is unpacked (camoufox alone compares only with the digest GitHub reports).
# camoufox asks the GitHub API which release to download; anonymous calls are rate-limited per address. An
# optional build secret `github_token` (docker build --secret id=github_token,env=GITHUB_TOKEN) raises the
# limit; it is mounted for this step only and never stored in the image.
RUN --mount=type=secret,id=github_token,required=false,uid=10002 \
    case "${TARGETARCH:-amd64}" in \
         amd64) expected="${CAMOUFOX_SHA256_AMD64}" ;; \
         arm64) expected="${CAMOUFOX_SHA256_ARM64}" ;; \
         *) echo "unsupported architecture ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && GITHUB_TOKEN="$(cat /run/secrets/github_token 2>/dev/null || true)" \
       python -m agent_helper.browser_server --fetch "${expected}" \
    && python -m agent_helper.browser_server --check-model

# No default command: the compose file starts either the browser server or the gateway.
