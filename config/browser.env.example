# The isolated browser of the web page reader (docs/decisions/0029). Example only; never commit the live
# file. The browser gets nothing but its WebSocket path: no service secret, no deny lists.

# A random path of at least 16 characters, the same as in browse-gateway.env
BROWSER_WS_PATH=
# The browser server ends itself after this many seconds and is restarted fresh (0: never; default 6 hours)
# BROWSER_MAX_LIFETIME_SECONDS=21600
