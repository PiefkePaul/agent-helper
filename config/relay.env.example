# Push relay (docs/decisions/0020, step 9). Example only: copy to the relay's server, adapt, never commit
# the live file. The relay has no database; it receives signed jobs from the service and sends them.

# Same value as RELAY_SECRET in the service's configuration (at least 32 random characters)
RELAY_SECRET=
# `public` or `allowlist` (then only PUSH_ALLOWED_DOMAINS)
PUSH_MODE=public
# PUSH_ALLOWED_DOMAINS=
# The operator's own names and networks: never contacted, whatever DNS says. Keep them in sync with the
# service's PUSH_DENY_DOMAINS.
# PUSH_DENY_DOMAINS=
# PUSH_DENY_NETS=
# PUSH_ALLOWED_PORTS=443
# All pushes per minute, across all destinations
# PUSH_MAX_PER_MIN=120
# Opt-out list (hosts that answered a verification with 410 or 403)
RELAY_DATA_DIR=/data
RELAY_LISTEN_PORT=8090
# Either terminate TLS in a proxy in front of the relay, or give a certificate and key here
# RELAY_TLS_CERT=/run/secrets/relay-cert.pem
# RELAY_TLS_KEY=/run/secrets/relay-key.pem
LOG_LEVEL=info
