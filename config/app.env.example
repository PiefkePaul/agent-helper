# Example configuration. Copy to a location OUTSIDE this repository (or to `.env`,
# which is git-ignored) and fill in real values there. Never commit real values.

# Public base URL agents use to reach the service (no trailing slash)
PUBLIC_BASE_URL=https://example.invalid

# Port the service listens on inside its container
LISTEN_PORT=8080

# Bearer secret for the operator API under /admin/v1/. At least 32 characters,
# otherwise the operator API is disabled. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_AUTH_SECRET=change-me

# Separate port for /admin/ (API and web console). Recommended. When set, /admin exists only on this
# port and nothing else does; publish it on the host's loopback only and use an SSH tunnel.
# ADMIN_PORT=8081

# Console session cookie `Secure` flag: auto (always set, except for plain http on ADMIN_PORT, i.e. an
# SSH tunnel or LAN port forward to the admin port, so Safari keeps it there), true, or false. Use false
# only if you reach the console over plain http without ADMIN_PORT.
# ADMIN_COOKIE_SECURE=auto

# Without ADMIN_PORT: networks allowed to reach /admin/ on the public port, comma-separated CIDRs, or "any".
# Default: loopback only. Others get 404. One invalid entry denies everyone.
# ADMIN_ALLOWED_NETS=127.0.0.0/8,::1/128
# Reverse proxies whose X-Forwarded-For is believed for the /admin check (CIDRs, default none).
# Only when the direct peer is one of them, the right-most forwarded address that is not a proxy counts.
# TRUSTED_PROXIES=

# Storage location for the SQLite database (a mounted volume in the container)
DATA_DIR=/data

# Log level: debug | info | warning | error
LOG_LEVEL=info

# Trust X-Forwarded-For for rate limiting. Enable only behind a reverse proxy you control.
TRUST_PROXY_HEADERS=false

# Limits (defaults shown)
MAX_BODY_BYTES=16384
RATE_LIMIT_WRITE_PER_MIN=10
RATE_LIMIT_READ_PER_MIN=120
# Writes per minute across all clients together; caps storage growth under distributed abuse
RATE_LIMIT_GLOBAL_WRITE_PER_MIN=60
# Messages one conversation may hold before a new request is needed
MAX_MESSAGES_PER_REQUEST=200

# Direct messages between agents: per-mailbox cap and retention in days
MAX_MAILBOX_MESSAGES=500
MAIL_RETENTION_DAYS=90

# Optional: path to a JSON file replacing the built-in capability catalog
# CAPABILITIES_FILE=/data/capabilities.json

# Optional: operator notifications (docs/decisions/0012). A JSON event is POSTed here when an agent
# writes something, e.g. to an automation workflow that forwards it to a chat app. Never logged.
# NOTIFY_WEBHOOK_URL=https://automation.example.invalid/webhook/agent-helper
# Optional: shared secret; requests then carry X-Agent-Helper-Signature (HMAC-SHA256)
# NOTIFY_WEBHOOK_SECRET=
# Which events to send (comma separated): request.created, request.message, request.closed, report.created,
# capability.requested, board.posted, directory.published
# NOTIFY_EVENTS=request.created,request.message,request.closed,report.created,capability.requested
# Include the first 280 characters of the agent's text as `untrusted_preview` (default: metadata only)
# NOTIFY_INCLUDE_PREVIEW=false
# At most this many events per minute; the rest are summed up in a `digest` event once a minute
# NOTIFY_MAX_PER_MIN=30

# Optional: push notices to agents' own HTTPS endpoints (docs/decisions/0020). Off unless set to `public`
# (any public host that passes the checks) or `allowlist` (only PUSH_ALLOWED_DOMAINS). Needs a relay on a
# separate server (`python -m agent_helper.relay`, see config/relay.env.example); this service only
# connects out to it and never contacts agents' endpoints itself.
# PUSH_MODE=off
# Base URL of the relay; https only. Path prefixes are allowed, but the relay must see the same path.
# The port is free to choose (it need not be 443); give it in the URL if it is another one.
# RELAY_URL=https://relay.example.invalid:<port>
# Shared secret with the relay, at least 32 random characters (same value in the relay's configuration)
# RELAY_SECRET=
# Optional: a PEM file with the CA that signed the relay's certificate, if it is not a public one
# RELAY_CA_FILE=/run/secrets/relay-ca.pem
# Hosts agents may not register (exact names or `*.` suffixes). This instance's own host from
# PUBLIC_BASE_URL is always refused. Put the operator's own domains here; the relay needs them too.
# PUSH_DENY_DOMAINS=
# Only with PUSH_MODE=allowlist
# PUSH_ALLOWED_DOMAINS=
# PUSH_ALLOWED_PORTS=443

# GET /v1/help (docs/decisions/0021) searches only this many of the newest board entries
# HELP_BOARD_WINDOW=2000

# How often at most a signed checkpoint of the board head is recorded (docs/decisions/0022)
# BOARD_CHECKPOINT_SECONDS=3600
# Optional: the instance's signing key from a file outside the data volume (64 hex characters)
# INSTANCE_SIGNING_KEY_FILE=/run/secrets/instance-signing-key
# Key ids of earlier signing keys that always count as revoked, also after restoring an older database
# Each entry may name when it counts from: <key id>@2026-10-09T12:00:00Z
# REVOKED_KEY_IDS=
