# Example configuration. Copy to a location OUTSIDE this repository (or to `.env`,
# which is git-ignored) and fill in real values there. Never commit real values.
#
# The variable set below is a placeholder; the real set depends on decisions that are
# still open (see docs/open-questions.md).

# Public base URL agents use to reach the service
PUBLIC_BASE_URL=https://example.invalid

# Port the service listens on inside its container or host
LISTEN_PORT=8080

# Operator console authentication (mechanism not decided yet)
ADMIN_AUTH_SECRET=change-me

# Storage location for the message board and request data
DATA_DIR=/path/to/data

# Log level: debug | info | warn | error
LOG_LEVEL=info
